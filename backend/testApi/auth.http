@baseUrl = http://localhost:8080/api/v1/auth
@token = <admin-jwt>
### Auth - Register a client user
POST {{baseUrl}}/register
Content-Type: application/json

{
    "nomComplet": "Client Test",
    "email": "client@test.com",
    "telephone": "770000001",
    "motDePasse": "Test1234!"
}

### Auth - Login as client
POST {{baseUrl}}/login
Content-Type: application/json

{
    "email": "client@test.com",
    "motDePasse": "Test1234!"
}

### Auth - Register an admin user
POST {{baseUrl}}/admin
Content-Type: application/json

{
    "nomComplet": "Admin Test",
    "email": "admin@test.com",
    "telephone": "770000002",
    "motDePasse": "Admin1234!"
}

### Auth - Login as admin
POST {{baseUrl}}/login
Content-Type: application/json

{
    "email": "admin@test.com",
    "motDePasse": "Admin1234!"
}

### Auth - List admins (paginated)
GET {{baseUrl}}/admins?page=0&size=10
Content-Type: application/json
Authorization: Bearer {{token}}
