@baseUrl = http://localhost:8080/api/v1/leads
@adminToken = <admin-jwt>

### Lead - Create lead (ADMIN)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": 1,
  "annonceId": 1,
  "visiteId": 1,
  "noteAdmin": "Lead créé après visite."
}

### Lead - List leads
GET {{baseUrl}}?page=0&size=20&statut=NEW
Authorization: Bearer {{adminToken}}

### Lead - Get lead by id
GET {{baseUrl}}/1
Authorization: Bearer {{adminToken}}

### Lead - Update lead status
PUT {{baseUrl}}/1/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "statut": "QUALIFIED",
  "noteAdmin": "Client intéressé."
}
