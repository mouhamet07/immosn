# ══════════════════════════════════════════════════════════
# ImmoSN — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs
# ══════════════════════════════════════════════════════════

# ── Base de données MySQL ───────────────────────────────────
DB_ROOT_PASSWORD=rootpassword
DB_NAME=immosn
DB_USER=immosn
DB_PASSWORD=immosn123

# ── JWT ────────────────────────────────────────────────────
# Clé secrète — OBLIGATOIRE de changer en production (min. 64 chars)
JWT_SECRET=ChangeThisSecretKeyInProductionImmosn2024XYZ
JWT_EXPIRATION=86400000

# ── Frontend (Vite) ────────────────────────────────────────
# URL de l'API — via Nginx le frontend et l'API partagent le même domaine
VITE_API_URL=/api/v1
