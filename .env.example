# ImmoSN — Variables d'environnement (template)
# 1. cp .env.example .env
# 2. Renseigner les valeurs ci-dessous

DB_HOST=ep-xxx-pooler.us-east-1.aws.neon.tech
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=votre_mot_de_passe_neon
DB_POOL_SIZE=5

# JWT
# Générer avec : openssl rand -base64 64  (minimum 64 caractères)
JWT_SECRET=CHANGEME_USE_A_STRONG_64_CHAR_SECRET_IN_PRODUCTION_ENV_MINIMUM_64_CHARS
JWT_EXPIRATION=86400000

# Bootstrap SUPER_ADMIN
SUPER_ADMIN_EMAIL=superadmin@immosn.sn
SUPER_ADMIN_PASSWORD=SuperAdmin@2026!
SUPER_ADMIN_NOM=Super Administrateur
SUPER_ADMIN_TELEPHONE=+221770000000

# CORS
# Docker production : même origine via Nginx → http://localhost
# Domaine personnalisé : https://votre-domaine.sn
CORS_ORIGINS=http://localhost

# Job expiration contrats
CONTRAT_EXPIRATION_CRON=0 5 0 * * *

# Pagination
PAGE_DEFAULT_SIZE=10
PAGE_ADMIN_SIZE=20

# DDL (update en dev, validate en prod stable)─
DDL_AUTO=update

# Frontend (Vite)
VITE_API_URL=/api/v1

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Twilio — SMS du numéro de suivi à la demande de visite (laisser TWILIO_ENABLED=false si non configuré)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Email — envoi du numéro de suivi par mail (laisser MAIL_ENABLED=false si non configuré)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@immosn.sn
