# ══════════════════════════════════════════════════════════
# ImmoSN — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs
# ⚠️  NE JAMAIS committer .env dans Git (.gitignore obligatoire)
# ══════════════════════════════════════════════════════════

# ── PostgreSQL Neon ────────────────────────────────────────
# Récupérer dans : https://console.neon.tech
#   Dashboard → votre projet → Connection Details → Connection string
# Format : postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://immosn_user:password@ep-xxx.us-east-1.aws.neon.tech/immosn?sslmode=require

# ── JWT ────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 64
JWT_SECRET=ChangeThisSecretKeyInProductionImmosn2024XYZ_MinimumSixtyFourCharsRandom
JWT_EXPIRATION=86400000

# ── Bootstrap SUPER_ADMIN ──────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@immosn.sn
SUPER_ADMIN_PASSWORD=SuperAdmin@2026!
SUPER_ADMIN_NOM=Super Administrateur
SUPER_ADMIN_TELEPHONE=+221770000000

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# ── Job expiration contrats ────────────────────────────────
CONTRAT_EXPIRATION_CRON=0 5 0 * * *

# ── Frontend (Vite) ────────────────────────────────────────
VITE_API_URL=/api/v1

# ── Cloudinary ─────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
